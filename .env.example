# Webhook that the contact form posts to server-side. If unset, the form
# will not fake a success state — it shows a clear message and a WhatsApp
# fallback instead (see app/api/contact/route.ts).
WEBHOOK_URL=

# Public site URL, used for canonical/OG/sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics is wired but off by default. Flip to "true" only after the
# cookie-consent banner is in place and a real provider is connected.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
